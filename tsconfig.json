// 该配置用于 src 和 test目录的ts（类型检查；声明文件由 build 脚本单独产出）
{
    "compilerOptions": {
        // 生成代码的模块风格（rollup 打包需要 es module 语法）
        "module": "ESNext",
        "moduleResolution": "bundler",

        // tsc编译输出的代码的es版本，保持 ES5 以兼容旧浏览器（TS7 将移除，先按 6.0 忽略弃用告警）
        "target": "ES5",
        "ignoreDeprecations": "6.0",

        "sourceMap": false,
        // "allowJs": true, // 不能和declaration一起使用
        "noImplicitReturns": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        // 回调等成员在 listenXxx/init 等方法里赋值，不满足“构造器内确定性赋值”，沿用旧行为关闭该检查
        "strictPropertyInitialization": false,
        "noFallthroughCasesInSwitch": true,

        "allowUnreachableCode": false,
        "allowUnusedLabels": false,

        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,

        "lib": ["es2017", "dom", "scripthost"],

        "rootDir": "src"
    },
    "compileOnSave": false,
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "**/*Spec.ts"
    ]
}
